.list-item {
    border-left-color: rgba(0, 255, 255, 0.3);
    border-right-color: rgba(0, 255, 255, 0.3);
    border-top-color: rgba(0, 255, 255, 0.3);
    border-bottom-color: rgba(0, 255, 255, 0.3);
}

.list-item:hover {
    border-left-color: rgb(0, 255, 255);
    border-right-color: rgb(0, 255, 255);
    border-top-color: rgb(0, 255, 255);
    border-bottom-color: rgb(0, 255, 255);
}

.list-item:disabled {
    border-left-color: rgba(0, 255, 255, 0.3);
    border-right-color: rgba(0, 255, 255, 0.3);
    border-top-color: rgba(0, 255, 255, 0.3);
    border-bottom-color: rgba(0, 255, 255, 0.3);
    opacity: 0.2;
}

.inactive-list-item {
    border-left-color: rgba(0, 255, 255, 0);
    border-right-color: rgba(0, 255, 255, 0);
    border-top-color: rgba(0, 255, 255, 0);
    border-bottom-color: rgba(0, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
