.system-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 255, 0.15);
    background-color: rgba(8, 12, 26, 0.3);
}

.pip-container {
    flex-direction: row;
    align-items: center;
    margin-right: 30px;
}

.pip {
    width: 12px;
    height: 6px;
    margin: 0 2px;
    border-radius: 0;
}

.pip--inactive {
    background-color: rgba(0, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.2);
}

.pip--active {
    background-color: rgb(0, 255, 255);
    border-width: 0;
    text-shadow: 0 0 4px rgba(0, 255, 255, 0.8);
}