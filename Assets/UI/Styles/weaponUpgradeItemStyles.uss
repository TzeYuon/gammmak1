.upgrade-item {
    flex-direction: row;
    align-items: center;
    padding: 10px 15px;
    margin-bottom: 6px;
    background-color: rgba(8, 12, 26, 0);
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 255);
    transition-property: opacity, background-color;
    transition-duration: 0.3s;
}

.upgrade-indicator {
    width: 14px;
    height: 14px;
    margin-right: 15px;
    background-color: rgb(0, 255, 255);
    border-width: 0;
    border-radius: 0;
}

.upgrade-item-text-container {
    flex-direction: column;
    flex-grow: 1;
}

.upgrade-item-title {
    font-size: 13px;
    color: rgb(224, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.upgrade-item-effect {
    font-size: 11px;
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-top: 1px;
}

.upgrade-item--locked {
    opacity: 0.35;
    background-color: rgba(8, 12, 26, 0.1);
    border-left-color: rgb(74, 87, 104);
}

.upgrade-item--locked .upgrade-indicator {
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(74, 87, 104);
}

.upgrade-item--locked .upgrade-item-title {
    color: rgb(74, 87, 104);
}

.upgrade-item--locked .upgrade-item-effect {
    color: rgb(74, 87, 104);
}
