:root {
}

.map-node {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border-width: 2px;
    translate: -50% -50%;
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    position: absolute;
}

.map-node-default {
    background-color: rgba(8, 12, 26, 0);
    border-color: rgba(0, 255, 255, 0.2);
    scale: 0.8;
}

.map-node-selectable {
    background-color: rgba(0, 255, 255, 0.15);
    border-color: rgb(0, 255, 255);
    scale: 1;
}

.map-node-selectable:hover {
    background-color: rgba(0, 255, 255, 0.8);
    scale: 1.3;
}

.map-node-current {
    background-color: rgb(255, 255, 255);
    border-color: rgb(0, 255, 255);
    scale: 1.4;
}

.map-node-selected {
    background-color: rgb(255, 0, 60);
    border-color: rgb(255, 255, 255);
    scale: 1.5;
}

.map-node-onpath {
    background-color: rgba(0, 255, 255, 0.25);
    border-color: rgba(0, 255, 255, 0.4);
    scale: 0.8;
}

.details-panel {
    width: 60%;
    height: 0;
    padding: 0 20px;
    transition-property: height, opacity, padding;
    transition-duration: 0.1s, 0.1s, 0.1s;
    transition-timing-function: linear, linear, linear;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    opacity: 0;
    overflow: hidden;
}

.details-panel--open {
    height: 50%;
    opacity: 1;
    padding: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 60%;
    border-left-color: rgba(0, 255, 255, 0.3);
    border-right-color: rgba(0, 255, 255, 0.3);
    border-top-color: rgba(0, 255, 255, 0.3);
    border-bottom-color: rgba(0, 255, 255, 0.3);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    opacity: 1;
    overflow: hidden;
}
