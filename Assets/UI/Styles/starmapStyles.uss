:root {
}

.map-node {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border-width: 2px;
    translate: -50% -50%;
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    position: absolute;
}

.map-node-default {
    scale: 0.8;
}

.map-node-selectable {
    scale: 1;
}

.map-node-selectable:hover {
    scale: 1.3;
}

.map-node-current {
    scale: 1.4;
}

.map-node-selected {
    scale: 1.5;
}

.map-node-onpath {
    scale: 0.8;
}

.node-encounter {
    background-image: url("project://database/Assets/UI/Icons/Icon_Encounter.svg?fileID=7388822144124034973&guid=b6464b675cc65c1478aee05b10db630c&type=3#Icon_Encounter");
    -unity-background-image-tint-color: rgb(255, 0, 0);
}

.node-elite {
    background-image: url("project://database/Assets/UI/Icons/Icon_Elite.svg?fileID=7388822144124034973&guid=4fb3c0f197671b24d9f848a0ed54b1c3&type=3#Icon_Elite");
    -unity-background-image-tint-color: rgb(255, 0, 0);
}

.node-shop {
}

.node-boss {
    background-image: url("project://database/Assets/UI/Icons/Icon_Boss.svg?fileID=7388822144124034973&guid=cd55725ec5cf12a4a8954d9e70455915&type=3#Icon_Boss");
    -unity-background-image-tint-color: rgb(255, 0, 0);
}

.reward-weapon {
    background-image: url("project://database/Assets/UI/Icons/Icon_WeaponBlueprint.svg?fileID=7388822144124034973&guid=ed3cb49705835334ca10ea638a850895&type=3#Icon_WeaponBlueprint");
    -unity-background-image-tint-color: rgb(204, 255, 0);
}

.reward-ship {
    background-image: url("project://database/Assets/UI/Icons/Icon_ShipBlueprint.svg?fileID=7388822144124034973&guid=97ebc228951d7ae4a827e053aa882b21&type=3#Icon_ShipBlueprint");
    -unity-background-image-tint-color: rgb(204, 255, 0);
}

.reward-cores {
    background-image: url("project://database/Assets/UI/Icons/Icon_UpgradeCore.svg?fileID=7388822144124034973&guid=a5cc65f603d08cf4aa5f643bbf1548a2&type=3#Icon_UpgradeCore");
    -unity-background-image-tint-color: rgb(204, 255, 0);
}

.reward-repair {
    -unity-background-image-tint-color: rgb(204, 255, 0);
}

.threat-low {
    border-color: rgb(0, 255, 255);
}

.threat-medium {
    border-color: rgb(255, 204, 0);
}

.threat-high {
    border-color: rgb(255, 0, 60);
}

.threat-boss {
    border-color: rgb(255, 0, 255);
}

.details-panel {
    width: 60%;
    height: 0;
    padding: 0 20px;
    transition-property: height, opacity, padding;
    transition-duration: 0.1s, 0.1s, 0.1s;
    transition-timing-function: linear, linear, linear;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    opacity: 0;
    overflow: hidden;
}

.details-panel--open {
    height: 50%;
    opacity: 1;
    padding: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 60%;
    border-left-color: rgba(0, 255, 255, 0.3);
    border-right-color: rgba(0, 255, 255, 0.3);
    border-top-color: rgba(0, 255, 255, 0.3);
    border-bottom-color: rgba(0, 255, 255, 0.3);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    opacity: 1;
    overflow: hidden;
}
