.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-base-slider__dragger {
    background-color: rgb(0, 255, 255);
    border-width: 0;
    border-radius: 0;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(255, 255, 255);
}

.unity-base-slider__dragger:active {
    background-color: rgb(255, 0, 60);
}

.unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.unity-scroller--vertical {
    width: 15px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    border-right-width: 1px;
    border-right-color: rgba(0, 255, 255, 0.1);
    width: 2px;
    margin-left: 10px;
    height: auto;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
    left: 8px;
}

.unity-scroller--horizontal {
    height: 15px;
    width: 100%;
}

.unity-scroller--horizontal .unity-base-slider__tracker {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 255, 0.1);
    height: 2px;
    margin-top: 10px;
    width: auto;
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 6px;
    top: 8px;
}
