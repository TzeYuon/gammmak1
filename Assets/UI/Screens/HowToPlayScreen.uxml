<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <engine:VisualElement name="Container" style="flex-grow: 1; background-color: rgb(8, 12, 26); width: 100%; height: 100%;">
        <engine:Label text="HOW TO PLAY" name="Header" class="text" style="border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 3px; font-size: 40px; -unity-text-align: upper-center; padding-top: 0; padding-right: 0; padding-bottom: 15px; padding-left: 0; margin-top: 15px; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        <engine:VisualElement style="flex-grow: 1; flex-direction: row;">
            <engine:VisualElement name="LeftContainer" style="flex-grow: 0; width: 250px; padding-top: 30px; padding-left: 0; padding-right: 0; border-right-width: 3px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); padding-bottom: 30px;">
                <engine:VisualElement name="NavigationBar" style="flex-grow: 0; padding-right: 15px; padding-left: 15px; padding-top: 0;">
                    <engine:Button text="BACK" name="BackBtn" class="defeat-continue-button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 25px; margin-left: 0; font-size: 20px; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0;"/>
                    <engine:Button text="BASIC CONTROLS" name="BasicControlsBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px;"/>
                    <engine:Button text="ECONOMY" name="EconomyBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px;"/>
                    <engine:Button text="THE SWARM" name="TheSwarmBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px;"/>
                    <engine:Button text="HANGAR" name="HangarBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px;"/>
                    <engine:Button text="STARMAP" name="StarmapBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px;"/>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
