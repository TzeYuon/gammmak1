<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <engine:VisualElement name="SelectedUnitContainer" class="button" style="flex-grow: 0; width: 170px; height: 72px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; flex-direction: row; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <engine:VisualElement name="UnitIcon" style="flex-grow: 0; width: 70px; height: 70px; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px;">
            <engine:VisualElement style="flex-grow: 1;"/>
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1;">
            <engine:Label text="INVINCIBLE" name="ShipNameLbl" class="text"/>
            <engine:Label text="x30" name="ShipCountLbl" class="text" style="-unity-font-style: normal; font-size: 16px;"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
