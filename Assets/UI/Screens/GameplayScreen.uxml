<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <engine:VisualElement name="SelectionBox" style="flex-grow: 1; position: absolute; background-color: rgba(0, 255, 0, 0.15); border-left-color: rgb(0, 255, 0); border-right-color: rgb(0, 255, 0); border-top-color: rgb(0, 255, 0); border-bottom-color: rgb(0, 255, 0); border-left-width: 1.5px; display: none;"/>
    <engine:VisualElement name="VictoryScreen" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgba(8, 12, 26, 0.85); justify-content: center; align-items: center; display: none;">
        <engine:Label text="MISSION OUTCOME:&#10;HIVES NEUTRALIZED&#10;VICTORY" name="Label" style="color: rgb(0, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0); font-size: 35px; -unity-font-style: normal; letter-spacing: 3px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Roboto_Mono/static/RobotoMono-Bold.ttf?fileID=12800000&amp;guid=b4c6db6af0eb9324ba661e41df476f51&amp;type=3#RobotoMono-Bold&quot;);"/>
        <engine:Button text="CONTINUE" name="VictoryContinueButton" class="victory-continue-button"/>
    </engine:VisualElement>
    <engine:VisualElement name="DefeatScreen" style="flex-grow: 1; position: absolute; align-items: center; justify-content: center; align-self: center; width: 100%; height: 100%; background-color: rgba(8, 12, 26, 0.85); display: none;">
        <engine:Label text="MISSION OUTCOME:&#10;MOTHERSHIP DESTROYED&#10;DEFEAT" style="color: rgb(255, 0, 60); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0); font-size: 35px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Roboto_Mono/static/RobotoMono-Bold.ttf?fileID=12800000&amp;guid=b4c6db6af0eb9324ba661e41df476f51&amp;type=3#RobotoMono-Bold&quot;); letter-spacing: 4px;"/>
        <engine:Button text="CONTINUE" name="DefeatContinueButton" class="defeat-continue-button"/>
    </engine:VisualElement>
    <engine:VisualElement name="ReinforcementPanel" style="flex-grow: 0; bottom: 0; position: absolute; translate: -50% 0; width: 600px; left: 50%; height: 150px; border-left-color: rgba(0, 255, 255, 0.43); border-right-color: rgba(0, 255, 255, 0.43); border-top-color: rgba(0, 255, 255, 0.43); border-bottom-color: rgba(0, 255, 255, 0.43); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; background-color: rgb(8, 12, 26);">
        <engine:Label text="BiomassCounter" name="BiomassCounter" class="text" style="top: auto; position: relative; left: auto; color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 25px; border-bottom-width: 2px; border-left-color: rgba(0, 255, 255, 0.43); border-right-color: rgba(0, 255, 255, 0.43); border-top-color: rgba(0, 255, 255, 0.43); border-bottom-color: rgba(0, 255, 255, 0.43);"/>
        <engine:VisualElement name="ReinforcementBtnContainer" style="flex-grow: 1; flex-direction: row;"/>
    </engine:VisualElement>
</engine:UXML>
