<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="SelectionBox" style="flex-grow: 1; position: absolute; background-color: rgba(0, 255, 0, 0.15); border-left-color: rgb(0, 255, 0); border-right-color: rgb(0, 255, 0); border-top-color: rgb(0, 255, 0); border-bottom-color: rgb(0, 255, 0); border-left-width: 1.5px; display: none;"/>
    <engine:VisualElement name="ReinforcementPopup" style="flex-grow: 1; position: absolute; background-color: rgba(8, 13, 26, 0.9); border-left-color: rgb(0, 255, 255); border-right-color: rgb(0, 255, 255); border-top-color: rgb(0, 255, 255); border-bottom-color: rgb(0, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; display: none; width: auto; top: auto; height: auto;">
        <engine:Label text="REINFORCEMENTS" name="Title" style="color: rgb(255, 255, 255); -unity-font-style: bold; margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
    </engine:VisualElement>
    <engine:Label text="BiomassCounter" name="BiomassCounter" style="top: 10px; position: absolute; left: 10px; background-color: rgba(8, 13, 26, 0.9); color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 255, 255); border-right-color: rgb(0, 255, 255); border-top-color: rgb(0, 255, 255); border-bottom-color: rgb(0, 255, 255); font-size: 25px;"/>
    <engine:VisualElement name="VictoryScreen" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgba(8, 12, 26, 0.85); justify-content: center; align-items: center; display: none;">
        <engine:Label text="MISSION OUTCOME:&#10;HIVES NEUTRALIZED&#10;VICTORY" name="Label" style="color: rgb(0, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0); font-size: 35px; -unity-font-style: bold;"/>
        <engine:Button text="CONTINUE" name="VictoryContinueButton" style="border-left-color: rgb(0, 255, 255); border-right-color: rgb(0, 255, 255); border-top-color: rgb(0, 255, 255); border-bottom-color: rgb(0, 255, 255); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; margin-top: 50px; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-definition: url(&quot;project://database/Assets/UI/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=4b543d0b74a3ecf49b506af0acaf12f7&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold; background-color: rgb(26, 26, 26); color: rgb(0, 255, 255); font-size: 20px;"/>
    </engine:VisualElement>
    <engine:VisualElement name="DefeatScreen" style="flex-grow: 1; position: absolute; align-items: center; justify-content: center; align-self: center; width: 100%; height: 100%; background-color: rgba(8, 12, 26, 0.85); display: flex;">
        <engine:Label text="MISSION OUTCOME:&#10;MOTHERSHIP DESTROYED&#10;DEFEAT" style="color: rgb(255, 0, 60); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0); font-size: 35px; -unity-font-style: bold;"/>
        <engine:Button text="CONTINUE" name="DefeatContinueButton" style="border-left-color: rgb(255, 0, 60); border-right-color: rgb(255, 0, 60); border-top-color: rgb(255, 0, 60); border-bottom-color: rgb(255, 0, 60); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; margin-top: 50px; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-definition: url(&quot;project://database/Assets/UI/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=4b543d0b74a3ecf49b506af0acaf12f7&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold; background-color: rgb(26, 26, 26); color: rgb(255, 0, 60); font-size: 20px;"/>
    </engine:VisualElement>
</engine:UXML>
