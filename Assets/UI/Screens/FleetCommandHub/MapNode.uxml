<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <MapNode node-state="Default" class="map-node" style="position: relative;">
        <ui:VisualElement name="NodeTypeSymbol" style="flex-grow: 1; position: absolute; width: 60%; height: 60%; translate: -50% -50%; top: 50%; left: 50%;"/>
        <ui:VisualElement name="ThreatBorder" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; translate: -50% -50%; top: 50%; left: 50%;"/>
        <ui:VisualElement name="RewardSymbol" style="flex-grow: 1; width: 40%; height: 40%; position: absolute; top: 110%; translate: -50% 0; left: 50%;"/>
    </MapNode>
</ui:UXML>
