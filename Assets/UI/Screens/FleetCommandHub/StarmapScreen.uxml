<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/starmapStyles.uss?fileID=7433441132597879392&amp;guid=0a69bb707ddc6d3448e1e4f5b25b9b53&amp;type=3#starmapStyles"/>
    <Style src="project://database/Assets/UI/Styles/sliderStyles.uss?fileID=7433441132597879392&amp;guid=2e1252ec56222c446830454bf619999a&amp;type=3#sliderStyles"/>
    <ui:VisualElement name="StarmapContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="MapContainer" style="flex-grow: 0; align-items: center; justify-content: center; flex-direction: column; width: 70%; height: 100%;">
                <MapPathCanvas name="MapPathCanvas" style="position: absolute; width: 100%; height: 100%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; align-items: center; justify-content: center;">
                <ui:VisualElement name="MapDetailsContainer" class="details-panel details-panel--open" style="flex-grow: 0; overflow: hidden;">
                    <ui:Label text="INTEL" name="Header" class="text" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 0; padding-bottom: 5px; padding-left: 0; font-size: 20px; border-bottom-width: 2px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3);"/>
                    <ui:Label text="Label" name="NodeTypeLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="ThreatLevelLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="ObjectiveLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="EnemyProfileLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="TerrainTypeLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="RewardTypeLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                    <ui:Label text="Label" name="AnomalyLbl" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; height: 12%; border-top-width: 2px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); align-items: center; justify-content: center;">
            <ui:Button text="[ DEPLOY ]" name="DeployBtn" class="button text" style="width: 250px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 75px; font-size: 30px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
