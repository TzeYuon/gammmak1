<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <ui:Button text="" name="ShipItemBtn" style="background-color: rgba(188, 188, 188, 0); flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 6px; margin-right: 5px; margin-bottom: 6px; margin-left: 8px; height: 90px;">
        <ui:VisualElement name="ShipItemVisualContainer" style="flex-grow: 0; aspect-ratio: 1; align-items: center; align-self: center; justify-content: center; width: auto; height: 100%;">
            <ui:VisualElement name="ShipItemVisual" style="flex-grow: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ShipItemLabels" style="flex-grow: 1;">
            <ui:Label text="Label" name="ShipItemName" class="text" style="flex-grow: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; -unity-text-align: middle-left; height: 25px;"/>
            <ui:Label text="Label" name="ShipItemClass" class="text" style="-unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; flex-grow: 0; height: 25px;"/>
            <ui:Label text="[ IN ROSTER ]" name="ShipItemStatus" class="text" style="-unity-text-align: middle-center; color: rgb(0, 255, 0);"/>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
