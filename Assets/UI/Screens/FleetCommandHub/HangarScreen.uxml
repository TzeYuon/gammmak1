<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/scrollviewStyles.uss?fileID=7433441132597879392&amp;guid=1c9e88b492e50ef4aa09e28f52ec1cc8&amp;type=3#scrollviewStyles"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/systemItemStyles.uss?fileID=7433441132597879392&amp;guid=4afa9fad7b8666247837b7b35602f7bc&amp;type=3#systemItemStyles"/>
    <Style src="project://database/Assets/UI/Styles/warningStyles.uss?fileID=7433441132597879392&amp;guid=214f8bf2247208e4cb81d9221a10243d&amp;type=3#warningStyles"/>
    <Style src="project://database/Assets/UI/Styles/weaponMountStyles.uss?fileID=7433441132597879392&amp;guid=5a28778424be49149b8d871ad490f0c1&amp;type=3#weaponMountStyles"/>
    <ui:VisualElement name="HangarContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; flex-direction: row;">
        <ui:VisualElement name="ShipListContainer" style="flex-grow: 0; width: 17%; border-right-width: 2px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); margin-right: 5px; margin-top: 5px; margin-bottom: 5px; margin-left: 5px; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px; align-self: center; width: 100%; justify-content: center;">
                <ui:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/Icons/Icon_ShipBlueprint.svg?fileID=7388822144124034973&amp;guid=97ebc228951d7ae4a827e053aa882b21&amp;type=3#Icon_ShipBlueprint&quot;); aspect-ratio: 1; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px;"/>
                <ui:Label text="HULL BLUEPRINTS" name="Header" class="text" style="font-size: 24px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 20px; padding-left: 8px; -unity-text-align: upper-left; flex-grow: 0;"/>
            </ui:VisualElement>
            <ui:ScrollView name="ShipsScrollView" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="DetailsContainer" style="flex-grow: 0; width: 55%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-right-width: 2px; display: flex; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
            <ui:Label text="SHIP NAME" name="ShipTitle" class="text" style="font-size: 35px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
            <ui:Label text="SHIP CLASS" name="ShipClass" class="text" style="font-size: 20px; letter-spacing: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 10px; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
            <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: column;">
                <PipContainer name="WeaponCapacityContainer" max-pips="0" colour="Orange" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; align-content: flex-start; flex-grow: 0; position: absolute; align-self: center; max-width: 48%; top: 10px;"/>
                <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
                    <ui:VisualElement name="ShipVisualContainer" style="flex-grow: 1; width: auto; height: 70%; align-items: center; align-content: auto; justify-content: center; background-image: url(&quot;project://database/Assets/UI/Screens/FleetCommandHub/ShipPreview.renderTexture?fileID=8400000&amp;guid=61a69b9133a10a842a366d9d63d2dd28&amp;type=2#ShipPreview&quot;); aspect-ratio: 1; align-self: center; -unity-background-image-tint-color: rgba(0, 255, 255, 0.35);"/>
                    <ui:VisualElement name="WeaponMountsContainer" style="flex-grow: 0; width: auto; height: auto; background-image: none; position: absolute;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row; height: 25%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-top-width: 2px;">
                    <ui:VisualElement name="ShipSystemsContainer" style="flex-grow: 0; width: 50%; height: 100%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0;">
                        <ui:Label text="SYSTEMS:" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 0; padding-bottom: 5px; padding-left: 5px; font-size: 20px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
                        <ui:ScrollView name="SystemsScrollView" horizontal-scroller-visibility="Hidden" style="padding-right: 0; padding-top: 0; padding-bottom: 30px; padding-left: 0; height: auto;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ShipDescriptionContainer" style="flex-grow: 0; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; margin-right: 0; height: 100%; width: 50%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 2px;">
                        <ui:Label text="DESCRIPTION:" name="Header" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; -unity-text-align: upper-left; font-size: 20px; width: auto;"/>
                        <ui:ScrollView name="ShipDescriptionScrollView" style="min-width: auto; min-height: auto; width: auto;">
                            <ui:Label text="" name="ShipDescription" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; width: 100%; font-size: 16px;"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="ADD TO ROSTER" name="ToggleRosterBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px; width: 100%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HangarContextMenu" style="flex-grow: 1; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 2px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px;">
            <ui:VisualElement name="ContextWeaponMount" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
                <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px; align-self: center; width: 100%; justify-content: center;">
                    <ui:VisualElement style="flex-grow: 0; aspect-ratio: 1; background-image: url(&quot;project://database/Assets/UI/Icons/Icon_WeaponBlueprint.svg?fileID=7388822144124034973&amp;guid=ed3cb49705835334ca10ea638a850895&amp;type=3#Icon_WeaponBlueprint&quot;); margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px;"/>
                    <ui:Label text="WEAPONS" name="WeaponMountLabel" class="text" style="font-size: 24px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 20px; padding-left: 0; -unity-text-align: upper-center; flex-grow: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="CurrentWeaponContainer" style="flex-grow: 0; height: 60%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px; padding-bottom: 0; margin-bottom: 10px;">
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="EQUIPPED:" name="CurrentlyEquippedLabel" class="text subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 0; padding-left: 5px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; font-size: 14px; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
                            <ui:Label text="WEAPON NAME" name="EquippedWeaponName" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 5px; padding-bottom: 5px; padding-left: 10px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0); border-right-color: rgba(0, 255, 255, 0); border-top-color: rgba(0, 255, 255, 0); border-bottom-color: rgba(0, 255, 255, 0); border-bottom-width: 2px; font-size: 16px;"/>
                        </ui:VisualElement>
                        <ui:Button text="UNEQUIP" name="UnequipBtn" class="button text" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; width: 99px; padding-top: 6px; padding-right: 4px; padding-bottom: 6px; padding-left: 4px; visibility: visible; display: flex;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="VIEWING:" name="CurrentlyViewingLabel" class="text subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 0; padding-left: 5px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; font-size: 14px; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
                            <ui:Label text="WEAPON NAME" name="ViewingWeaponName" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 5px; padding-bottom: 5px; padding-left: 10px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0); border-right-color: rgba(0, 255, 255, 0); border-top-color: rgba(0, 255, 255, 0); border-bottom-color: rgba(0, 255, 255, 0); border-bottom-width: 2px; font-size: 16px;"/>
                        </ui:VisualElement>
                        <ui:Button text="EQUIP" name="EquipBtn" class="button text" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; width: 99px; padding-top: 6px; padding-right: 4px; padding-bottom: 6px; padding-left: 4px; visibility: visible; display: flex;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="WeaponDetailsContainer" style="flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement style="flex-grow: 0; flex-direction: column; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 100%;">
                            <ui:VisualElement style="flex-grow: 0; flex-direction: row; height: auto; aspect-ratio: auto; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px; width: auto;">
                                <ui:VisualElement name="WeaponVisualContainer" style="flex-grow: 0; height: auto; align-items: center; justify-content: center; width: 50%; aspect-ratio: 1;">
                                    <ui:VisualElement name="WeaponVisual" style="flex-grow: 0; width: auto; height: auto;"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="WeaponDescriptionContainer" style="flex-grow: 0; padding-left: 5px; padding-top: 0; padding-right: 5px; width: 50%; height: 100%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 2px; aspect-ratio: 1;">
                                    <ui:ScrollView name="ShipDescriptionScrollView">
                                        <ui:Label text="DESCRIPTION:" name="WeaponDescription" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-left; font-size: 14px;"/>
                                    </ui:ScrollView>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: flex-end;">
                                <ui:Button text="REFUND [COST]" name="RefundWeaponBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 14px; width: 50%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; letter-spacing: 5px;"/>
                                <ui:Button text="UPGRADE [COST]" name="UpgradeWeaponBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 14px; width: 50%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; letter-spacing: 5px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="VisualElement" style="flex-grow: 1; max-height: none;">
                                <ui:ScrollView horizontal-scroller-visibility="Hidden" style="flex-grow: 0; height: 100%; flex-direction: column;">
                                    <ui:VisualElement name="WeaponUpgradeContainer" style="flex-grow: 1; flex-direction: column; margin-bottom: 10px; height: auto;"/>
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:ScrollView name="WeaponsScrollView" style="height: auto;">
                        <ui:VisualElement name="WeaponsScrollViewContainer" style="flex-grow: 0; flex-direction: row; flex-wrap: wrap; height: 100%;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; position: absolute; top: 50%; left: 50%; width: 80%; translate: -50% -50%;">
            <ui:Label text="" name="HangarWarningLbl" class="text warning" style="white-space: normal; max-width: 100%; height: auto; -unity-text-align: upper-left; padding-bottom: 12px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: auto; position: relative; top: auto; left: auto; translate: 0 0%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
