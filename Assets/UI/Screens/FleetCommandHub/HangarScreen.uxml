<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/scrollviewStyles.uss?fileID=7433441132597879392&amp;guid=1c9e88b492e50ef4aa09e28f52ec1cc8&amp;type=3#scrollviewStyles"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <ui:VisualElement name="HangarContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; flex-direction: row;">
        <ui:VisualElement name="ShipListContainer" style="flex-grow: 0; width: 20%; border-right-width: 2px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3);">
            <ui:Label text="HULL BLUEPRINTS" name="Header" class="text" style="font-size: 24px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 20px; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
            <ui:ScrollView name="ShipsScrollView" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="DetailsContainer" style="flex-grow: 0; width: 50%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-right-width: 2px; display: flex;">
            <ui:Label text="SHIP NAME" name="ShipTitle" class="text" style="font-size: 40px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
            <ui:Label text="SHIP CLASS" name="ShipClass" class="text" style="font-size: 20px; letter-spacing: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 20px; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
            <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="LeftContainer" style="flex-grow: 0; width: 50%;">
                    <ui:VisualElement name="ShipVisualContainer" style="flex-grow: 0; width: auto; height: 40%; align-items: center; align-content: auto; justify-content: center;">
                        <ui:VisualElement name="ShipVisual" style="flex-grow: 0; width: auto; height: auto;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ShipDescriptionContainer" style="flex-grow: 1; padding-left: 5px; padding-top: 0; padding-right: 5px;">
                        <ui:ScrollView name="ShipDescriptionScrollView">
                            <ui:Label text="DESCRIPTION:" name="ShipDescription" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-left; font-size: 16px;"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="RightContainer" style="flex-grow: 1; flex-direction: column; border-left-width: 2px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3);">
                    <ui:VisualElement name="ShipSystemsContainer" style="flex-grow: 0; width: 100%; height: 50%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;">
                        <ui:Label text="SYSTEMS:" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 0; padding-bottom: 5px; padding-left: 5px; font-size: 20px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
                        <ui:ScrollView name="SystemsScrollView" style="margin-right: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; padding-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="WeaponMountsContainer" style="flex-grow: 1; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0;">
                        <ui:Label text="WEAPON MOUNTS:" class="text" style="padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 20px;"/>
                        <ui:Label text="Label" name="EnergyUsedLabel" class="subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; font-size: 16px;"/>
                        <ui:ScrollView name="WeaponMountsScrollView" style="height: 100%; flex-wrap: wrap; margin-top: 8px; margin-left: 8px; margin-bottom: 8px;">
                            <ui:VisualElement name="WeaponMountScrollViewContainer" style="flex-grow: 0; flex-wrap: wrap; flex-direction: row;"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="ADD TO ROSTER" name="ToggleRosterBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px; width: 100%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; border-top-width: 1px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HangarContextMenu" style="flex-grow: 1; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 0;">
            <ui:VisualElement name="ContextWeaponMount" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
                <ui:Label text="WEAPONS" name="WeaponMountLabel" class="text" style="font-size: 24px; letter-spacing: 5px; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 20px; padding-left: 0; -unity-text-align: upper-center; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;"/>
                <ui:VisualElement name="CurrentWeaponContainer" style="flex-grow: 0; height: 50%; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px; padding-bottom: 0; margin-bottom: 10px;">
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="EQUIPPED:" name="CurrentlyEquippedLabel" class="text subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 0; padding-left: 5px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; font-size: 14px; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
                            <ui:Label text="WEAPON NAME" name="EquippedWeaponName" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 5px; padding-bottom: 5px; padding-left: 10px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0); border-right-color: rgba(0, 255, 255, 0); border-top-color: rgba(0, 255, 255, 0); border-bottom-color: rgba(0, 255, 255, 0); border-bottom-width: 2px; font-size: 16px;"/>
                        </ui:VisualElement>
                        <ui:Button text="UNEQUIP" name="UnequipBtn" class="button text" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; width: 99px; padding-top: 6px; padding-right: 4px; padding-bottom: 6px; padding-left: 4px; visibility: visible; display: flex;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 2px;">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="VIEWING:" name="CurrentlyViewingLabel" class="text subtext" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 0; padding-left: 5px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-bottom-width: 0; font-size: 14px; border-top-width: 0; border-right-width: 0; border-left-width: 0;"/>
                            <ui:Label text="WEAPON NAME" name="ViewingWeaponName" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 5px; padding-bottom: 5px; padding-left: 10px; white-space: pre-wrap; -unity-text-align: upper-left; border-left-color: rgba(0, 255, 255, 0); border-right-color: rgba(0, 255, 255, 0); border-top-color: rgba(0, 255, 255, 0); border-bottom-color: rgba(0, 255, 255, 0); border-bottom-width: 2px; font-size: 16px;"/>
                        </ui:VisualElement>
                        <ui:Button text="EQUIP" name="EquipBtn" class="button text" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; width: 99px; padding-top: 6px; padding-right: 4px; padding-bottom: 6px; padding-left: 4px; visibility: visible; display: flex;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="WeaponDetailsContainer" style="flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                            <ui:VisualElement name="LeftContainer" style="flex-grow: 0; width: 45%;">
                                <ui:VisualElement name="WeaponVisualContainer" style="flex-grow: 0; height: 100px; align-items: center; justify-content: center;">
                                    <ui:VisualElement name="WeaponVisual" style="flex-grow: 0; width: auto; height: auto;"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="WeaponDescriptionContainer" style="flex-grow: 1; padding-left: 5px; padding-top: 0; padding-right: 5px;">
                                    <ui:ScrollView name="ShipDescriptionScrollView">
                                        <ui:Label text="DESCRIPTION:" name="WeaponDescription" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-left; font-size: 14px;"/>
                                    </ui:ScrollView>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="RightContainer" style="flex-grow: 1; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-left-width: 2px;">
                                <ui:VisualElement name="WeaponUpgradeContainer" style="flex-grow: 1; flex-direction: column-reverse; margin-bottom: 5px;"/>
                                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                                    <ui:Button text="REFUND [COST]" name="RefundWeaponBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 14px; width: 50%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; letter-spacing: 5px; border-top-width: 1px;"/>
                                    <ui:Button text="UPGRADE [COST]" name="UpgradeWeaponBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 14px; width: 50%; height: 50px; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; letter-spacing: 5px; border-top-width: 1px;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:ScrollView name="WeaponsScrollView" style="height: auto;">
                        <ui:VisualElement name="WeaponsScrollViewContainer" style="flex-grow: 0; flex-direction: row; flex-wrap: wrap; height: 100%;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
