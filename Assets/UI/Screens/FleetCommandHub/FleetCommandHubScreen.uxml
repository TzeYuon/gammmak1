<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="HangarScreen" src="project://database/Assets/UI/Screens/FleetCommandHub/HangarScreen.uxml?fileID=9197481963319205126&amp;guid=0037f696daf23c64ca927b9a0f02da52&amp;type=3#HangarScreen"/>
    <ui:Template name="StarmapScreen" src="project://database/Assets/UI/Screens/FleetCommandHub/StarmapScreen.uxml?fileID=9197481963319205126&amp;guid=b17aab59ad47e614ca65e9db8cb14188&amp;type=3#StarmapScreen"/>
    <ui:Template name="WeaponsScreen" src="project://database/Assets/UI/Screens/FleetCommandHub/WeaponsScreen.uxml?fileID=9197481963319205126&amp;guid=e29635767b97c8848a344bc2fc71f47a&amp;type=3#WeaponsScreen"/>
    <Style src="project://database/Assets/UI/Styles/textStyles.uss?fileID=7433441132597879392&amp;guid=0fcfa4debd24b3b4d8af003b3cf8a592&amp;type=3#textStyles"/>
    <Style src="project://database/Assets/UI/Styles/scrollviewStyles.uss?fileID=7433441132597879392&amp;guid=1c9e88b492e50ef4aa09e28f52ec1cc8&amp;type=3#scrollviewStyles"/>
    <Style src="project://database/Assets/UI/Styles/buttonStyles.uss?fileID=7433441132597879392&amp;guid=fb4d964bd72d3fb49a27b9c537745707&amp;type=3#buttonStyles"/>
    <Style src="project://database/Assets/UI/Styles/systemItemStyles.uss?fileID=7433441132597879392&amp;guid=4afa9fad7b8666247837b7b35602f7bc&amp;type=3#systemItemStyles"/>
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(8, 12, 26); flex-direction: row;">
        <ui:VisualElement name="LeftContainer" style="flex-grow: 0; width: 250px; padding-top: 30px; padding-left: 15px; padding-right: 15px; border-right-width: 3px; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); padding-bottom: 30px;">
            <ui:VisualElement name="NavigationBar" style="flex-grow: 0; height: 150px;">
                <ui:Button text="HANGAR" name="HangarBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;"/>
                <ui:Button text="WEAPONS" name="WeaponsBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; display: none;"/>
                <ui:Button text="STARMAP" name="StarmapBtn" class="text button" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; font-size: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ActiveRosterContainer" style="flex-grow: 1; height: auto; border-left-color: rgba(0, 255, 255, 0.3); border-right-color: rgba(0, 255, 255, 0.3); border-top-color: rgba(0, 255, 255, 0.3); border-bottom-color: rgba(0, 255, 255, 0.3); border-top-width: 3px; flex-direction: column; justify-content: flex-start; align-content: auto; align-items: center; align-self: auto; width: 100%; padding-top: 5px; margin-top: 50px;">
                <ui:Label text="ACTIVE ROSTER" name="Label" class="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 10px; padding-left: 0;"/>
                <ui:VisualElement style="flex-grow: 0; flex-direction: column; width: 100%; height: 100%; background-color: rgb(21, 36, 69);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentArea" style="flex-grow: 1;">
            <ui:Instance template="StarmapScreen" name="StarmapScreen" style="width: 100%; height: 100%; position: absolute;"/>
            <ui:Instance template="WeaponsScreen" name="WeaponsScreen" style="position: absolute; width: 100%; height: 100%;"/>
            <ui:Instance template="HangarScreen" name="HangarScreen" style="position: absolute; width: 100%; height: 100%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
