<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(8, 12, 26); flex-direction: row;">
        <ui:VisualElement name="NavigationBar" style="flex-grow: 0; width: 250px; padding-top: 30px; padding-left: 15px; padding-right: 15px; border-right-width: 3px; border-left-color: rgb(21, 36, 69); border-right-color: rgb(21, 36, 69); border-top-color: rgb(21, 36, 69); border-bottom-color: rgb(21, 36, 69);">
            <ui:Button text="Hangar" name="HangarBtn" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; color: rgb(173, 216, 230); border-left-color: rgb(21, 36, 69); border-right-color: rgb(21, 36, 69); border-top-color: rgb(21, 36, 69); border-bottom-color: rgb(21, 36, 69); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; -unity-font-style: bold;"/>
            <ui:Button text="Loadout" name="LoadoutBtn" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 15px; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; color: rgb(173, 216, 230); border-left-color: rgb(21, 36, 69); border-right-color: rgb(21, 36, 69); border-top-color: rgb(21, 36, 69); border-bottom-color: rgb(21, 36, 69); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; -unity-font-style: bold;"/>
            <ui:Button text="Starmap" name="StarmapBtn" style="background-color: rgb(26, 26, 26); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 4px; padding-right: 0; padding-bottom: 4px; padding-left: 0; color: rgb(173, 216, 230); border-left-color: rgb(21, 36, 69); border-right-color: rgb(21, 36, 69); border-top-color: rgb(21, 36, 69); border-bottom-color: rgb(21, 36, 69); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ContentArea" style="flex-grow: 1;">
            <ui:VisualElement name="HangarContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
                <ui:Label text="Hangar" style="font-size: 50px; color: rgb(255, 0, 0);"/>
            </ui:VisualElement>
            <ui:VisualElement name="LoadoutContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
                <ui:Label text="Loadout" style="font-size: 50px; color: rgb(255, 0, 0);"/>
            </ui:VisualElement>
            <ui:VisualElement name="StarmapContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
                <ui:Label text="Star&#10;" style="font-size: 50px; color: rgb(255, 0, 0);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
