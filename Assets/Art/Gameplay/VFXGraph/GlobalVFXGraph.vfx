  m_OperatorName: Custom HLSL
  m_HLSLCode: "void FloatFunction(ByteAddressBuffer buffer, uint index, out float3
    position, out uint type, out float4 colour, out float4 customData)\n{\n\tuint
    offset = Index * 48;\r\n\tposition = asfloat(Buffer.Load3(offset));\r\n\ttype
    = Buffer.Load(offset + 12);\r\n\tcolour = asfloat(Buffer.Load4(offset + 16));\r\n\tcustomData
    = asfloat(Buffer.Load4(offset + 32));\n}\t"
  m_ShaderFile: {fileID: 10900000, guid: 289efa7fc70956a4d8c522970539ff43, type: 3}
  m_AvailableFunctions:
    selection: FloatFunction
    selectedIndex: 0
