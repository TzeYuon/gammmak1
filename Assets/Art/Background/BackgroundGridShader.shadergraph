    },
    "m_SourceType": 1,
    "m_FunctionName": "HexGrid",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = UV * Scale;\r\nconst float2 s = float2(1.0, 1.7320508);\r\nfloat2 p1 = p / s;\r\nfloat2 p2 = p1 - float2(0.5, 0.5);\r\n\r\nfloat2 h1 = round(p1);\r\nfloat2 h2 = round(p2) + float2(0.5, 0.5);\r\n\r\nfloat2 d1 = p - h1 * s;\r\nfloat2 d2 = p - h2 * s;\r\n\r\nfloat2 center = dot(d1, d1) < dot(d2, d2) ? h1 : h2;\r\nfloat2 localPos = p - center * s;\r\n\r\nlocalPos = abs(localPos);\r\nfloat dist = max(dot(localPos, float2(0.5, 0.8660254)), localPos.x);\r\n\r\nOut = smoothstep(0.5 - LineThickness, 0.5, dist);"
}

